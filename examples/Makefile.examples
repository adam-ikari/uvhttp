###############################################################################
# UVHTTP Examples Makefile
#
# Builds every .c file under examples/ with one rule. Source files are
# auto-discovered; the target name is the file's basename (all 52 are unique).
#
# Usage:
#   make -f Makefile.examples                  # build all examples
#   make -f Makefile.examples <name>           # build one (e.g. api_demo)
#   make -f Makefile.examples production_app   # real embedder + Web dashboard
#   make -f Makefile.examples clean
###############################################################################

BUILD_DIR ?= ../build_static
SRC_DIR ?= .
INCLUDE_DIR ?= ../include
DEPS_DIR ?= ../deps
LIB_DIR ?= $(BUILD_DIR)/dist/lib
BIN_DIR ?= ./bin

CC ?= gcc

# Feature macros MUST match the library we link against. Derive them from the
# build tree's flags.make so a stale manual list cannot drift out of sync.
FEATURE_FLAGS = $(shell sed -n 's/^C_DEFINES = //p' $(BUILD_DIR)/CMakeFiles/uvhttp.dir/flags.make 2>/dev/null | grep -oE '\-DUVHTTP_[A-Z0-9_]+(=[^ ]+)?' | grep -E 'FEATURE|ALLOCATOR|ENABLE_TLS|ZEROCOPY|MAX_|BUFFER_SIZE')

CFLAGS = -Wall -Wextra -pthread $(FEATURE_FLAGS) \
         -I$(INCLUDE_DIR) -I$(DEPS_DIR)/uthash/src \
         -I$(DEPS_DIR)/llhttp/include -I$(DEPS_DIR)/cjson \
         -I$(DEPS_DIR)/mbedtls/include -I$(DEPS_DIR)/libuv/include \
         -std=gnu99
# The lib is static; uvhttp's PUBLIC deps are linked explicitly here.
LDFLAGS = -L$(LIB_DIR) \
          -L$(DEPS_DIR)/mbedtls/build/library -L$(DEPS_DIR)/llhttp/build \
          -L$(DEPS_DIR)/xxhash -L$(DEPS_DIR)/cjson/build \
          -luvhttp -luv -lmbedtls -lmbedx509 -lmbedcrypto \
          -lxxhash -lllhttp -lcjson -lminiz -lpthread -lm -ldl

DEBUG_FLAGS = -g -O0
RELEASE_FLAGS = -O2
BUILD_TYPE ?= release
ifeq ($(BUILD_TYPE),debug)
  CFLAGS += $(DEBUG_FLAGS)
else
  CFLAGS += $(RELEASE_FLAGS)
endif

# Auto-discover every example source; target = basename without .c.
SOURCES := $(shell find $(SRC_DIR) -name '*.c' -type f)
EXAMPLES := $(notdir $(basename $(SOURCES)))
# Map a target name back to its source path (works because names are unique).
src_of = $(firstword $(filter %/$(1).c,$(SOURCES)) $(filter $(1).c,$(SOURCES)))

.PHONY: all clean help check_uvhttp $(EXAMPLES)

all: $(BIN_DIR) check_uvhttp $(EXAMPLES)
	@echo ""
	@echo "Built $$(echo $(EXAMPLES) | wc -w) examples into $(BIN_DIR)/"

help:
	@echo "UVHTTP Examples Makefile"
	@echo ""
	@echo "Usage: make -f Makefile.examples [target] [options]"
	@echo ""
	@echo "Targets:"
	@echo "  all              Build all $$(echo $(EXAMPLES) | wc -w) examples (default)"
	@echo "  <name>           Build one example by basename"
	@echo "  clean            Remove build artifacts"
	@echo "  help             Show this help"
	@echo ""
	@echo "Options:"
	@echo "  BUILD_TYPE=debug   Build with -g -O0"
	@echo "  BUILD_DIR=...      Library build tree (default ../build_static)"
	@echo "  CC=...             C compiler"
	@echo ""
	@echo "Selected targets: $(EXAMPLES)"
	@echo ""

$(BIN_DIR):
	@mkdir -p $(BIN_DIR)

# One pattern-like rule per example via a generated explicit rule.
define make_example
$(1): $(BIN_DIR) check_uvhttp
	@echo "Building $(1) from $(call src_of,$(1))..."
	$$(CC) $$(CFLAGS) $$(call src_of,$(1)) -o $$(BIN_DIR)/$(1) $$(LDFLAGS)
	@echo "  ✓ $(1)"
endef
$(foreach e,$(EXAMPLES),$(eval $(call make_example,$(e))))

clean:
	@rm -rf $(BIN_DIR)
	@echo "  ✓ Clean completed"

check_uvhttp:
	@if [ ! -f $(LIB_DIR)/libuvhttp.a ]; then \
		echo ""; \
		echo "Error: UVHTTP library not found at $(LIB_DIR)/libuvhttp.a"; \
		echo "Build a feature-complete tree first:"; \
		echo "  cmake -S .. -B $(BUILD_DIR) -DBUILD_WITH_STATIC_FILES=ON"; \
		echo "  cmake --build $(BUILD_DIR) -j$$(nproc)"; \
		echo ""; \
		exit 1; \
	fi
